# Entra ID App Registration (Entra ID → App Registrations → cavalry-sso-oidc-finance → Overview)
TENANT_ID=your-entra-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Must match exactly what you set in App Registration → Authentication → Redirect URIs
REDIRECT_URI=http://localhost:4001
4002/auth/callback

# Session secret — use a long random string in production
SESSION_SECRET=change-this-to-a-long-random-secret

PORT=4001
4002
